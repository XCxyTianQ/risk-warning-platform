{
  "name": "risk-warning-desktop",
  "productName": "企业经营风险预警平台",
  "version": "0.7.0",
  "description": "基于多模态大模型的企业经营风险预警平台 · Windows / macOS 桌面端",
  "main": "main.js",
  "private": true,
  "author": "risk-warning-platform",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env RWP_DEV=1 electron .",
    "smoke": "cross-env RWP_SMOKE=1 electron .",
    "smoke:window": "cross-env RWP_SMOKE=2 electron .",
    "icons": "node -e \"require('child_process').execSync('python scripts/make_icons.py',{stdio:'inherit'})\"",
    "build:web": "node scripts/build-web.js",
    "build:backend": "node scripts/build-backend.js",
    "dist": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --win --x64",
    "dist:dir": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --win --x64 --dir",
    "dist:mac": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --mac",
    "dist:mac:arm64": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --mac --arm64",
    "dist:mac:x64": "node scripts/build-web.js && node scripts/build-backend.js && electron-builder --mac --x64"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.riskwarning.platform",
    "productName": "RiskWarningPlatform",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/web",
        "to": "web"
      },
      {
        "from": "resources/samples",
        "to": "samples"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RiskWarningPlatform-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "企业经营风险预警平台",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "RiskWarningPlatform-${version}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "artifactName": "RiskWarningPlatform-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "artifactName": "RiskWarningPlatform-${version}-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
