# 复制为 .env 后按需修改（.env 不入库）

# LLM 三参数（OpenAI 兼容端点）
# 可用模型（2026-09 实测，均支持 function calling）：
#   deepseek-v4-flash              快/便宜，适合批量研判
#   deepseek-v4-pro                能力最强，适合核心研判
#   deepseek-v4-flash-vision-exp   多模态（图像/表格/票据），平台默认
#   deepseek-chat / deepseek-reasoner   兼容别名（实际路由到 v4）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-key-here
LLM_MODEL=deepseek-v4-flash-vision-exp
# 推理型模型会消耗 reasoning tokens，建议 ≥4096
LLM_MAX_TOKENS=4096

# 本地 mock（离线开发，零成本）：LLM_BASE_URL=http://127.0.0.1:9000/v1 + LLM_MODEL=mock

# 数据库（原型 SQLite；正式换 postgresql://user:pass@host/db）
DATABASE_URL=sqlite:///./data/platform.db
